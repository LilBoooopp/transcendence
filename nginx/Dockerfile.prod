# Build context: repository root (see docker-compose.prod.yml).
FROM node:22-alpine AS frontend

WORKDIR /app

COPY frontend/package*.json ./

RUN npm ci

COPY frontend/ ./

# No inline runtime chunk: the Content-Security-Policy in nginx.prod.conf only allows scripts from our own files.
ENV GENERATE_SOURCEMAP=false INLINE_RUNTIME_CHUNK=false

RUN npm run build

FROM nginx:alpine

RUN rm /etc/nginx/conf.d/default.conf

COPY nginx/nginx.prod.conf /etc/nginx/nginx.conf

# The image's entrypoint fills these with env vars (TRUSTED_PROXY) into /etc/nginx/conf.d/
COPY nginx/templates /etc/nginx/templates

COPY --from=frontend /app/build /usr/share/nginx/html

CMD ["nginx", "-g", "daemon off;"]
