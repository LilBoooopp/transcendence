# PostgreSQL Configuration
POSTGRES_USER=chess_user
# Generated by `make` (hex, so it is safe inside DATABASE_URL). Postgres refuses to start if empty.
POSTGRES_PASSWORD=
POSTGRES_DB=chess_platform

# JWT Config (generated by `make`)
JWT_SECRET=

# Admins are not configured here: register the account, then run `make admin username=<name>`.

# ── Production (`make prod`) ──────────────────────────────────────────────────
# TLS lives in Nginx Proxy Manager (Let's Encrypt). Its proxy host forwards to http://<this host>:HTTP_PORT,
# with "Websockets Support" on. Bind to the address NPM reaches (e.g. 192.168.1.20:8080) to keep the plain
# HTTP port off other interfaces.
HTTP_PORT=8080
# Address/CIDR NPM connects from; only it may set the visitor IP through X-Forwarded-For. The default covers
# NPM running in Docker on this host; use NPM's LAN IP (e.g. 192.168.1.10) when it runs on another machine.
TRUSTED_PROXY=172.16.0.0/12

# ── Development (`make`) only ────────────────────────────────────────────────
NODE_ENV=development
# Extra browser origins allowed to call the API (comma separated). Empty = localhost defaults.
CORS_ORIGINS=
REACT_APP_API_URL=https://localhost/api
REACT_APP_WS_URL=http://localhost:4000
